Algoritmo "regras_negocio_emprestimo"
Var
   renda: real
   restricao: inteiro
Inicio
   escreva("Digite a renda mensal: ")
   leia(renda)
   escreva("Possui restricao no Serasa (Sim (1) / Nao (0))? ")
   leia(restricao)

   se ((renda >= 3000.00) E (restricao = 0))entao
   escreval("EMPRESTIMO APROVADO: ", "VERDADEIRO")
   senao
   escreval("EMPRESTIMO NÃO APROVADO ", "FALSO")
   fimse

Fimalgoritmo